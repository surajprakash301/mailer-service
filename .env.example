PORT=8787
DATA_DIR=data

# Prefer Gemini for market pick / research / pitch (OpenAI optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma list tried after GEMINI_MODEL on 503 / soft 429
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-1.5-flash-8b

# Optional local fallback only (not used on Render)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

RESEND_API_KEY=re_...
FROM_EMAIL=Loky Media <surajprakash@lokymedia.com>
REPLY_TO=support@lokymedia.com

# Public base for email images (banner). Local: http://localhost:8787 — Render: https://mailer-service-dhq1.onrender.com
EMAIL_ASSET_BASE_URL=http://localhost:8787
APP_URL=https://mailer-service-dhq1.onrender.com

# Set to false only when you are ready to send live mail
DRY_RUN=true

# Protect gather / campaign / send-live when set (header: x-cron-secret)
CRON_SECRET=

# On free hosts (Render): disable in-process cron; use cron-job.org HTTP triggers
DISABLE_INTERNAL_CRON=false

# Daily cap for the 8:45 AM IST cron (and /campaigns/run)
MAX_EMAILS_PER_DAY=25

# Milliseconds between Resend API calls
SEND_DELAY_MS=800

# Morning gather (research + draft, no send) then 8:45 send
GATHER_CRON=0 7 * * *
SEND_CRON=45 8 * * *
GATHER_INDUSTRIES=10
GATHER_COMPANIES_PER_INDUSTRY=3
GATHER_MAX_LEADS=25
# Optional: comma override of data/durga-puja-industries.json labels
# GATHER_FOCUS_INDUSTRIES=Jewellery,Fashion & Apparel,Retail,Automobile

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Approved template name required for cold outreach when live
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# On-prem style contacts check (often unavailable on Cloud API)
WHATSAPP_ENABLE_CONTACTS_CHECK=false
# Defaults to DRY_RUN; set false only with a live WABA
WHATSAPP_DRY_RUN=true

# Supabase (emailer_table / durable leads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for durable gather/send (server-only; never commit the real value)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=emailer-table
