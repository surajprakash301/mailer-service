PORT=8787
DATA_DIR=data

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

RESEND_API_KEY=re_...
FROM_EMAIL=Loky Media <outreach@lokymedia.com>
REPLY_TO=support@lokymedia.com

# Set to false only when you are ready to send live mail
DRY_RUN=true

# Protect gather / campaign / send-live when set (header: x-cron-secret)
CRON_SECRET=

# Daily cap for the 8:45 AM IST cron (and /campaigns/run)
MAX_EMAILS_PER_DAY=25

# Milliseconds between Resend API calls
SEND_DELAY_MS=800

# Morning gather (research + draft, no send) then 8:45 send
GATHER_CRON=0 7 * * *
SEND_CRON=45 8 * * *
GATHER_INDUSTRIES=3
GATHER_COMPANIES_PER_INDUSTRY=2

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Approved template name required for cold outreach when live
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# On-prem style contacts check (often unavailable on Cloud API)
WHATSAPP_ENABLE_CONTACTS_CHECK=false
# Defaults to DRY_RUN; set false only with a live WABA
WHATSAPP_DRY_RUN=true
